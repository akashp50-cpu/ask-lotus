# Postgres connection string (Neon in production)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# 32+ random characters. Signs sessions and encrypts the AI key. Never change it after launch.
APP_SECRET=
NODE_ENV=production
# First admin account, created by `npm run seed` (must change password at first sign-in)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Akash Patel
